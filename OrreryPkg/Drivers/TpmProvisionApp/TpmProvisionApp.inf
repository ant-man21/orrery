## TpmProvisionApp.inf
##
## UEFI Application – "Setup First Boot" provisioning flow:
##   1. Init TPM / locate TCG2 protocol
##   2. Boot (unsigned for now)
##   3. Measure ROM -> extend PCR[15]
##   4. Compute PCR[15] policy digest
##   5. Define NV index gated on that policy
##   6. Write the secret into it via a real policy session
##
## Run once against a wiped/clean TPM. Every subsequent boot runs
## TpmVerifyBootApp instead, against the live ROM only.
##
## Companion app: TpmVerifyBootApp (reboot / unseal / tamper-detect flow).
##
## Add to a platform DSC (e.g. Q35Pkg.dsc) under [Components]:
##   OrreryPkg/Drivers/TpmProvisionApp/TpmProvisionApp.inf
##
## Output: Build/<DSC>/<TARGET>_<TOOLCHAIN>/<ARCH>/TpmProvisionApp.efi
## Run from the UEFI shell as fs1:\apps\TpmProvisionApp.efi

[Defines]
  INF_VERSION     = 0x00010005
  BASE_NAME       = TpmProvisionApp
  FILE_GUID       = 0773106d-320c-498d-992e-6a2253ff8c41
  MODULE_TYPE     = UEFI_APPLICATION
  VERSION_STRING  = 1.0
  ENTRY_POINT     = UefiMain

[Sources]
  TpmProvisionApp.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  SecurityPkg/SecurityPkg.dec
  CryptoPkg/CryptoPkg.dec
  OrreryPkg/OrreryPkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint       ## provides UefiMain linkage
  UefiLib                         ## Print, etc.
  UefiBootServicesTableLib        ## gBS
  UefiRuntimeServicesTableLib     ## gRT (for later phases)
  BaseMemoryLib                   ## ZeroMem, CopyMem, CompareMem
  MemoryAllocationLib             ## AllocateZeroPool, FreePool
  PrintLib                        ## SPrint
  Tpm2CommandLib                  ## Tpm2PcrRead, Tpm2NvDefineSpace, Tpm2NvWrite, Tpm2HierarchyChangeAuth …
  Tpm2PolicyPcrLib                ## Tpm2PolicyPCR (OrreryPkg-local — see its header)
  Tpm2PcrLib                      ## BuildPcrSelection/OpenPcrPolicySession/ExtendPcr (OrreryPkg-local, shared with TpmVerifyBootApp)
  Tpm2PolicyAuthorizeLib          ## Tpm2LoadExternal/Tpm2VerifySignature/Tpm2PolicyAuthorize (OrreryPkg-local — issue #15)
  Tpm2DeviceLib                   ## low-level TPM device abstraction
  BaseCryptLib                    ## Sha256HashAll (used in later phases)
  PlatformRomInfoLib              ## where's my own flash ROM (OrreryPkg-local, platform-specific instance — see docs/rom_discovery_story.md)
  RngLib                          ## GetRandomNumber128 (random secret — issue #15)
  DebugLib
  PcdLib

[Protocols]
  gEfiTcg2ProtocolGuid                   ## CONSUMES
  gEfiSimpleFileSystemProtocolGuid       ## CONSUMES  (read the update ticket off the shared volume — issue #15)

[Guids]
  gEfiTpmDeviceInstanceTpm20DtpmGuid     ## for TPM device selection
  gEfiFileInfoGuid                       ## EFI_FILE_INFO (ticket file size)
  gEfiFileSystemInfoGuid                 ## EFI_FILE_SYSTEM_INFO (locate volume by FAT label)

[FixedPcd]
  gOrreryPkgTokenSpaceGuid.PcdPcrForBios ## CONSUMES

[BuildOptions]
  ## Suppress "C99 declaration after statement" warnings that trip up
  ## some GCC builds when mixing C99-isms with UEFI coding style.
  GCC:*_*_*_CC_FLAGS = -std=c11 -Wno-error=declaration-after-statement
