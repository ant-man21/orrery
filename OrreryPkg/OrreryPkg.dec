## =============================================================================
## OrreryPkg.dec — OrreryPkg package declaration
##
## Shared drivers/libraries used by more than one platform package (Q35Pkg,
## ArmVirtOrreryPkg, ...). Platform-specific drivers live in their own
## platform package instead. Declares LibraryClasses that are implemented
## locally (as opposed to the vendored edk2/ tree), so a `git pull` on edk2/
## never has to carry project-specific patches.
## =============================================================================

[Defines]
  DEC_SPECIFICATION              = 0x00010005
  PACKAGE_NAME                   = OrreryPkg
  PACKAGE_GUID                   = a7af8704-b46d-4fba-b1e3-cf71f94becf9
  PACKAGE_VERSION                = 0.1

[Includes]
  Include

[Guids]
  ## Token space GUID for PCDs owned by this package.
  gOrreryPkgTokenSpaceGuid = { 0x9d25c291, 0x4964, 0x40b8, { 0xbe, 0x02, 0xdc, 0x5a, 0x17, 0x45, 0x7a, 0x2c }}

[PcdsFixedAtBuild]
  ## PCR index the ROM measurement is extended into (TpmProvisionApp /
  ## TpmVerifyBootApp) and that tools/sign_rom_ticket.py's offline hash
  ## chain must match. PCR15: non-resettable (platform-reset only, unlike
  ## PCR16), outside the PC Client PFP's PCR0-7 SRTM range owned by
  ## platform firmware phases — see issue #27. Fixed-at-build since
  ## changing it requires re-provisioning anyway: the sealed secret's
  ## policy digest is baked to this specific PCR value.
  gOrreryPkgTokenSpaceGuid.PcdPcrForBios|15|UINT32|0x00000001

[LibraryClasses]
  ## TPM2_PolicyPCR command wrapper — not provided by SecurityPkg's
  ## Tpm2CommandLib (EDK2 firmware never needed PCR-gated policy sessions,
  ## so upstream has no wrapper for it). Kept here instead of patching
  ## edk2/ directly.
  Tpm2PolicyPcrLib|Include/Library/Tpm2PolicyPcrLib.h

  ## PCR selection/session/extend helpers shared between TpmProvisionApp
  ## and TpmVerifyBootApp (previously duplicated byte-for-byte — see
  ## issue #8).
  Tpm2PcrLib|Include/Library/Tpm2PcrLib.h

  ## "Where is my own boot firmware volume" — one platform-agnostic
  ## interface, one library instance per platform (PlatformRomInfoLibQ35,
  ## PlatformRomInfoLibArmVirt, ...), selected in each platform DSC.
  ## Runtime discovery (FV2/FVB2 enumeration, GCD memory type) proved
  ## unreliable on both existing platforms — see docs/rom_discovery_story.md.
  PlatformRomInfoLib|Include/Library/PlatformRomInfoLib.h
  
  ## TPM2_LoadExternal / TPM2_VerifySignature / TPM2_PolicyAuthorize —
  ## same gap as Tpm2PolicyPcrLib above: SecurityPkg's Tpm2CommandLib
  ## doesn't provide these either. Signed-ticket reprovisioning — issue #15.
  Tpm2PolicyAuthorizeLib|Include/Library/Tpm2PolicyAuthorizeLib.h
